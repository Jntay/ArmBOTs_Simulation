<mujoco model="scene">
  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
  </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient"
             rgb1="0.35 0.55 0.65" rgb2="0.1 0.18 0.3"
             width="512" height="512"/>
    <texture name="groundplane" type="2d" builtin="checker"
             rgb1="0.4 0.4 0.4" rgb2="0.3 0.3 0.3"
             width="512" height="512"/>
    <material name="groundplane" texture="groundplane" texrepeat="40 40"/>
  </asset>

  <worldbody>
    <geom name="ground" type="plane" size="5 5 0.1" material="groundplane"/>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.4 0.4 0.4"/>
  </worldbody>

  <include file="robot.xml"/>
</mujoco>